/critical-thinking
coverage.txt

# Agent state and the dev container — never part of the image
.claude
.private-journal
.devcontainer

# The Claude Code plugin ships from the repo, not from the image
plugins

# Docker build definitions and release tooling — the image never needs its own recipe
Dockerfile*
.dockerignore
